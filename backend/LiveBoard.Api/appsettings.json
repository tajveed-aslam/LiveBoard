{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "LiveBoard",
    "Audience": "LiveBoard.Client",
    "ExpiryMinutes": 480
  },
  "Demo": {
    "GuestAccessEnabled": true,
    "GuestTokenMinutes": 240,
    "GuestSessionsPerHourPerIp": 10,
    "WritesPerHour": 1500
  },
  "Limits": {
    "MaxBoardsPerUser": 50,
    "MaxBoardsPerGuest": 10,
    "MaxColumnsPerBoard": 20,
    "MaxCardsPerBoard": 500
  },
  "Cors": {
    "Origins": [ "http://localhost:5175" ]
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
